[Unit]
Description=km3 real-time controller
# 需要 CAN 与串口就绪；数据盘不参与实时路径
After=km3-can.service
Wants=km3-can.service

    # 重启限速。**必须放在 [Unit]**：systemd 229 起这两个键从 [Service]
    # 迁到 [Unit]，放错节只会打印 "Unknown key name ... ignoring" 并静默忽略，
    # 表现为故障时被无限快速重启拖住（systemd-analyze verify 实测）。
    StartLimitIntervalSec=60
    StartLimitBurst=5

[Service]
Type=simple
# 显式传 --config 与 --require-config：
#   --config         默认值就是 /etc/km3/device.json，写出来是为了让"读哪份配置"可见
#   --require-config 配置缺失或校验不过即拒绝启动（退出码 3）。
#                    不加它时缺配置只是打印一行然后**用默认参数继续**——
#                    对一个会动的控制回路，"看起来正常地跑起来"比拒绝启动危险得多。
#                    该能力由 main.cpp 实现，早期单元漏传，等于白实现。
ExecStart=/opt/km3/current/km3-rt-controller --config /etc/km3/device.json --require-config
Restart=on-failure
RestartSec=1

# 实时调度与内存锁定：只授予需要它们的这个单元，而不是把程序变成 root
User=km3
Group=km3
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
LimitMEMLOCK=infinity
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=90
CPUAffinity=4-7

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data

[Install]
WantedBy=multi-user.target
