+    def close(self, out=None):
+        # Carry forward a prior measured disable without issuing another
+        # request against an action-locked node. It is historical evidence,
+        # not a fresh close-time read or a mechanical-stop assertion.
+        with self.lock:
+            if self.shutdown_results is not None:
+                return self.shutdown_results
+            prior = {}
+            for node, session in self.enabled_sessions.items():
+                w = self._cleanup_witnesses.get(node)
+                if (w and w['session'] is session and w['client'] is session.client and self.manual_sessions.get(node) is session
+                        and w['disabled_confirmed'] is True and w['state_unknown'] is False
+                        and w['cleanup_error'] is None and not session.needs_stop
+                        and not getattr(session.client, 'quarantined', False)
+                        and w['epoch'] == getattr(session.client, 'manual_write_epoch', 0)
+                        and self.context and (self.context[0],node) in self.blocked):
+                    prior[node] = session
+            for node in prior:
+                self.enabled_sessions.pop(node)
+            try:
+                result = super().close(out)
+                for node in prior:
+                    w = self._cleanup_witnesses[node]
+                    result.append(dict(node=node, disabled_confirmed=True, source='prior_cleanup',
+                        observed_at_utc=w['observed_at_utc'], shutdown_attempted=False,
+                        mechanical_stop_confirmed=False))
+                    line = '节点 {} 先前清理已确认失能（{}）；本次退出未发请求，机械停止未知'.format(node,w['observed_at_utc'])
+                    self.shutdown_lines.append(line)
+                    if out:
+                        out.info(line)
+                result.sort(key=lambda item:item['node'])
+                return result
+            finally:
+                self.enabled_sessions.update(prior)
 
