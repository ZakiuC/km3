+        send('\r')
+        view('detail')
+        send(b'\x1bOQ')  # xterm F2, normal shared Form path
+        for value in ('-2000','500','364'):
+            view('setting')
+            send(value)
+            send(f5)
+            # Give the ordinary key loop one turn before the next field.
