+    def _remember_partial(self, node, exc, context=None):
+        partial = getattr(exc, 'manual_partial_diagnostic', {})
+        reason = str(exc) or ('等待期间已取消' if isinstance(exc,KeyboardInterrupt) else type(exc).__name__)
+        if node not in self.failure_diagnostics:
+            # This attempt's actual fields (including unknown/None) take
+            # precedence over a previous successful transaction sample.
+            first = copy.deepcopy(partial or context or {})
+            if partial and context:
+                word = context.get('controlword')
+                first['expected_controlword'] = word
+                if context.get('snapshot_serial') == partial['snapshot_serial']:
+                    for key in ('phase','allowed_states','expected_state','point'):
+                        if key in context:
+                            first[key] = copy.deepcopy(context[key])
+                    # Preserve the existing phase-CW field and make its
+                    # planned provenance explicit beside observed_controlword.
+                    first['controlword'] = word
+                    first['controlword_source'] = '阶段控制字（非本轮6040h实读）'
+                else:
+                    first['previous_phase'] = context.get('phase')
+                    first['expected_controlword_source'] = '前一阶段上下文，非本轮实读'
+            first['reason'] = reason
+            self.failure_diagnostics[node] = first
+        first = self.failure_diagnostics[node]
+        if first.get('controlword') is not None and 'controlword_source' not in first:
+            first['controlword_source'] = '阶段控制字（非本轮6040h实读）'
+            first['expected_controlword'] = first['controlword']
+        # A phase observer's first failure has richer transaction evidence.
+        # Fill missing data only; cleanup cannot overwrite that first sample.
+        if first.get('snapshot_serial') == partial.get('snapshot_serial'):
+            for key, value in partial.items():
+                if first.get(key) is None:
+                    first[key] = copy.deepcopy(value)
+        first.setdefault('node', node)
+        first.setdefault('reason', reason)
+        first.setdefault('controlword_source', '阶段控制字（非本轮6040h实读）' if first.get('controlword') is not None else '未知')
+        return first
+
+    def _persist_failure(self, node, first, cleanup, out):
+        if node in self.diagnostic_paths:
+            return
+        base = getattr(self.args, 'motion_log', None)
+        if not base:
+            out.bad('诊断日志缺失：未指定--motion-log；首次失败仍保留在本会话内存')
+            return
+        path = Path(base)
+        path = path.with_name(path.stem + '-diagnostics-' + self._diagnostic_run + '-node-' + str(node) + '.jsonl')
+        self.diagnostic_paths[node] = str(path)
+        journal = None
+        try:
+            journal = position.Journal(str(path), 'manual_diagnostics', dict(node=node,
+                motion_log_base=str(base)), observer=None)
+            journal.event('manual_first_failure', first_failure=first)
+            journal.event('manual_cleanup', first_failure=first, **cleanup)
+            journal.close()
+            journal = None
+            out.info('故障诊断日志：' + str(path))
+        except BaseException as log_exc:
+            out.bad('诊断日志缺失或不完整：{}；{}；原始失败：{}'.format(path,log_exc,first.get('reason')))
+        finally:
+            if journal is not None:
+                try:
+                    journal.close()
+                except BaseException:
+                    pass
 
