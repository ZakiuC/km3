{
  "name": "km3-admin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "km3 管理页面（管-F01 至 管-F06）。设计权威见 docs/架构设计/管理端Web程序架构.md",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests --ext .ts,.vue",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "typecheck:dts": "vite build --mode development >/dev/null && vue-tsc --noEmit"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.1.6"
  }
}
